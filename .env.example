# Copy this file to .env.local (for local testing) and add the same
# variables in Vercel -> Project -> Settings -> Environment Variables.

# Where messages from the contact form should arrive:
CONTACT_TO_EMAIL=you@example.com

# ---- OPTION A: Gmail / any SMTP (easiest) ----
# Gmail: turn on 2-Step Verification, then create an "App password"
# at https://myaccount.google.com/apppasswords and paste it below.
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-letter-app-password
# Optional (defaults are for Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ---- OPTION B: Resend (https://resend.com) ----
# If RESEND_API_KEY is set it is used instead of SMTP.
# On the free plan, CONTACT_TO_EMAIL must be the email you signed up with.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=Untold Story <onboarding@resend.dev>
